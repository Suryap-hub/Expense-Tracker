# ---------------------------------------------------------------- required
# MongoDB Atlas: Database > Connect > Drivers. Put the DB name before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/spendwise?retryWrites=true&w=majority
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---------------------------------------------------------------- app
NODE_ENV=development
PORT=5000
# Where the React app runs (used in email links + CORS)
CLIENT_URL=http://localhost:5173
# If your ISP blocks Atlas SRV lookups ("querySrv ECONNREFUSED"), uncomment:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------------------------------------------------------------- Groq AI
# Free key: https://console.groq.com/keys  (leave empty to use the basic parser)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_INSIGHTS_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------- email
# Leave SMTP_HOST empty in development: emails (with verify links) print to the console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#        SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>
# Brevo (300/day free): smtp-relay.brevo.com, port 587, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SpendWise <you@gmail.com>"

# ---------------------------------------------------------------- scheduling
ENABLE_CRON=true
CRON_TIMEZONE=Asia/Kolkata
# Set to call POST /api/jobs/monthly-summary from an external cron (free hosts sleep)
CRON_SECRET=
